<Application x:Class="ObsidianInstaller.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Identidade do site Obsidian OS: obsidiana, cobre e Sora. -->
        <SolidColorBrush x:Key="Bg" Color="#000000" />
        <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#161616" Offset="0" />
            <GradientStop Color="#0A0A0A" Offset="0.55" />
            <GradientStop Color="#040404" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Accent" Color="#FF6B1A" />
        <SolidColorBrush x:Key="Secondary" Color="#FFB27A" />
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Muted" Color="#A8A8A8" />
        <SolidColorBrush x:Key="Line" Color="#2BFFFFFF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#33FF6B1A" />
        <SolidColorBrush x:Key="OnAccent" Color="#160A03" />
        <FontFamily x:Key="HeadingFont">/Assets/#Sora</FontFamily>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Application.Resources>
</Application>
