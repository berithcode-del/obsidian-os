<Window x:Class="ObsidianInstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obsidian OS · Instalador" Height="820" Width="1240" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Headline" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="700" />
            <Setter Property="Margin" Value="0,0,0,26" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="26,15" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Rail" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="36,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="26" Height="26" Margin="0,0,12,0">
                        <Canvas Width="32" Height="32">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"
                                  Data="M16,2 L29,9.5 L29,22.5 L16,30 L3,22.5 L3,9.5 Z M3,9.5 L16,17 L29,9.5 M16,17 L16,30 M9.5,5.7 L22.5,13" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="OBSIDIAN" FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Text=" OS" FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="  /  INSTALADOR" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="10,2,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="14,7">
                    <TextBlock x:Name="VersionChip" Text="v1.0 · CANAL LAB" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#050505">
                <DockPanel Margin="34,38,26,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="INSTALAÇÃO" Style="{StaticResource Label}" Margin="0,0,0,22" />
                        <Button x:Name="RailStep1" Style="{StaticResource Rail}" Click="Rail_Click" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RailNum1" Text="01" FontFamily="{StaticResource HeadingFont}" FontSize="12" Foreground="{StaticResource Accent}" Width="38" VerticalAlignment="Center" />
                                <TextBlock Text="Conectar" FontSize="14" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2,0,2" />
                        <Button x:Name="RailStep2" Style="{StaticResource Rail}" Click="Rail_Click" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RailNum2" Text="02" FontFamily="{StaticResource HeadingFont}" FontSize="12" Foreground="{StaticResource Muted}" Width="38" VerticalAlignment="Center" />
                                <TextBlock Text="Cartão" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2,0,2" />
                        <Button x:Name="RailStep3" Style="{StaticResource Rail}" Click="Rail_Click" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RailNum3" Text="03" FontFamily="{StaticResource HeadingFont}" FontSize="12" Foreground="{StaticResource Muted}" Width="38" VerticalAlignment="Center" />
                                <TextBlock Text="Gravar" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
                        <TextBlock Text="Feito para o seu portátil." Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="Pensado para a próxima história." Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Background="{StaticResource Bg}">
                <Grid x:Name="ContentGrid" Margin="44,42,44,48" MaxWidth="880" HorizontalAlignment="Left">

                    <StackPanel x:Name="PageConnect">
                        <TextBlock Text="PASSO 01 — PREPARAÇÃO" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Headline}"><Run Text="Conecte o " /><Run Text="console." Foreground="{StaticResource Accent}" FontStyle="Italic" /></TextBlock>
                        <TextBlock Style="{StaticResource Lead}"
                                   Text="Coloque o cartão no console com o aparelho desligado e ligue-o pelo cabo USB, ou use um leitor de cartões. O instalador reconhece, prepara e grava — sem você escolher arquivo." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CONSOLE" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ConsoleValue" Text="Procurando…" FontSize="15" Foreground="{StaticResource Ink}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ConsoleDot" Grid.Column="1" Text="●" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CARTÃO DE DESTINO" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="CardValue" Text="Nenhum cartão encontrado" FontSize="15" Foreground="{StaticResource Ink}" />
                                        <TextBlock x:Name="CardDetail" Text="" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="CardDot" Grid.Column="1" Text="●" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SISTEMA" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="PackageValue" Text="Lendo pacote…" FontSize="15" Foreground="{StaticResource Ink}" />
                                        <TextBlock x:Name="PackageDetail" Text="" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="PackageDot" Grid.Column="1" Text="●" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="Continuar" Click="Primary_Click" IsEnabled="False" />
                            <Button x:Name="BootstrapButton" Style="{StaticResource Ghost}" Content="Enviar carregador ao console" Click="Bootstrap_Click" Margin="12,0,0,0" Visibility="Collapsed" />
                            <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="Procurar de novo" Click="Refresh_Click" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="HintText" Style="{StaticResource Mono}" Margin="0,18,0,0"
                                   Text="O console só liga quando não está conectado ao computador. Para gravar: conecte o cabo com o console desligado e sem o cartão — ele entra em modo FEL e o instalador envia o carregador sozinho." />
                    </StackPanel>

                    <StackPanel x:Name="PageCard" Visibility="Collapsed">
                        <TextBlock Text="PASSO 02 — DESTINO" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Headline}"><Run Text="Confirme o " /><Run Text="cartão." Foreground="{StaticResource Accent}" FontStyle="Italic" /></TextBlock>
                        <TextBlock Style="{StaticResource Lead}"
                                   Text="Confira o modelo e a capacidade. A gravação apaga tudo o que estiver neste cartão — partições, jogos e saves." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CARTÃO SELECIONADO" Style="{StaticResource Label}" />
                                <TextBlock x:Name="TargetTitle" Text="—" FontFamily="{StaticResource HeadingFont}" FontSize="24" Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="TargetMeta" Text="" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,18" />
                                <TextBlock Text="OUTROS DISCOS ENCONTRADOS" Style="{StaticResource Label}" />
                                <ListBox x:Name="TargetList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}"
                                         SelectionChanged="TargetList_SelectionChanged" MaxHeight="140" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#120A05" BorderBrush="#5A2E12" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                            <TextBlock Text="Esta operação é irreversível. Tudo neste cartão será substituído pelo Obsidian OS 1.0."
                                       Foreground="#FFB27A" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <CheckBox x:Name="ConfirmCheck" Foreground="{StaticResource Ink}" Margin="0,0,0,22"
                                  Checked="ConfirmCheck_Changed" Unchecked="ConfirmCheck_Changed">
                            <TextBlock Text="Entendo e quero gravar o Obsidian OS 1.0 neste cartão." FontSize="13" />
                        </CheckBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Primary}" Content="Gravar sistema" Click="Write_Click" IsEnabled="False" x:Name="WriteButton" />
                            <Button Style="{StaticResource Ghost}" Content="Voltar" Click="Back_Click" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PageWrite" Visibility="Collapsed">
                        <TextBlock Text="PASSO 03 — GRAVAÇÃO" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="WriteHeadline" Style="{StaticResource Headline}"><Run Text="Gravando." /></TextBlock>
                        <TextBlock x:Name="WriteLead" Style="{StaticResource Lead}"
                                   Text="Não desconecte o cabo. Acompanhe cada etapa abaixo." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S1Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S1Text" Grid.Column="1" Text="Conferir a imagem" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S2Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S2Text" Grid.Column="1" Text="Apagar o cartão" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S3Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S3Text" Grid.Column="1" Text="Testar o enlace USB" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S4Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S4Text" Grid.Column="1" Text="Gravar a imagem" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S5Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S5Text" Grid.Column="1" Text="Reler e conferir" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="S6Dot" Text="○" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="S6Text" Grid.Column="1" Text="Preparar a área OBSIDIAN" FontSize="13" Foreground="{StaticResource Muted}" />
                                </Grid>
                                <ProgressBar x:Name="WriteBar" Style="{StaticResource Bar}" Value="0" Margin="0,20,0,10" />
                                <TextBlock x:Name="WriteStatus" Style="{StaticResource Mono}" Text="Aguardando a autorização do Windows…" />
                            </StackPanel>
                        </Border>

                        <Expander Foreground="{StaticResource Muted}" Header="Detalhes técnicos" IsExpanded="False" Margin="0,0,0,16">
                            <TextBox x:Name="WriteLog" IsReadOnly="True" Height="150" Margin="0,10,0,0"
                                     Background="#050505" Foreground="{StaticResource Muted}" BorderBrush="{StaticResource Line}"
                                     FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" />
                        </Expander>

                        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" Background="#0B0B0B" BorderBrush="#3A2314">
                                <StackPanel>
                                    <TextBlock Text="PRÓXIMO PASSO" Style="{StaticResource Label}" />
                                    <TextBlock Text="Desconecte o cabo USB do computador e ligue o console." Foreground="{StaticResource Ink}" FontSize="14" Margin="0,0,0,8" />
                                    <TextBlock Text="O console não liga enquanto estiver conectado ao computador. Sem o cabo, na primeira partida aparece a abertura do Obsidian OS; o cartão de jogos (TF2) pode ficar no segundo slot."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AgainButton" Style="{StaticResource Primary}" Content="Gravar outro cartão" Click="Again_Click" />
                                <Button Style="{StaticResource Ghost}" Content="Restaurar conteúdo" Click="GoRestore_Click" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PageRestore" Visibility="Collapsed">
                        <TextBlock Text="OPCIONAL — CONTEÚDO" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Headline}"><Run Text="Seus livros e " /><Run Text="jogos." Foreground="{StaticResource Accent}" FontStyle="Italic" /></TextBlock>
                        <TextBlock Style="{StaticResource Lead}"
                                   Text="Copie a sua coleção para o cartão. Nada aqui altera o sistema já gravado." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ORIGEM" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Ghost}" Content="Escolher pasta" Click="RestoreFolder_Click" />
                                    <Button Style="{StaticResource Ghost}" Content="Escolher imagem .img" Click="RestoreImage_Click" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="RestoreSource" Style="{StaticResource Mono}" Margin="0,12,0,0" Text="Nenhuma origem selecionada" />
                                <ItemsControl x:Name="RestoreItems" Margin="0,14,0,0" />
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16" />
                                <TextBlock Text="DESTINO" Style="{StaticResource Label}" />
                                <ComboBox x:Name="RestoreVolume" Margin="0,4,0,10" Height="30" Background="#050505" Foreground="{StaticResource Ink}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Primary}" Content="Restaurar" Click="Restore_Click" />
                                    <Button Style="{StaticResource Ghost}" Content="Voltar" Click="Back_Click" Margin="12,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="RestoreStatus" Style="{StaticResource Mono}" Margin="0,14,0,0" Text="" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="36,0">
                <TextBlock x:Name="FooterLeft" Style="{StaticResource Mono}" VerticalAlignment="Center" Text="Pacote local · verificando…" />
                <TextBlock x:Name="FooterRight" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Nada foi gravado ainda" />
            </Grid>
        </Border>
    </Grid>
</Window>
